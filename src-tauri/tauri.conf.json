{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBuildCommand": "deno task build",
		"beforeDevCommand": "deno task dev",
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": {
			"target/plugins/": "plugins/",
			"../LICENSE.md": "LICENSE.md",
			"../NOTICE": "NOTICE",
			"../CHANGES": "CHANGES",
			"../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md"
		},
		"licenseFile": "../LICENSE.md",
		"linux": {
			"deb": {
				"desktopTemplate": "bundle/opendeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/usr/share/metainfo/opendeck.metainfo.xml": "bundle/opendeck.metainfo.xml"
				}
			},
			"rpm": {
				"desktopTemplate": "bundle/opendeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/usr/share/metainfo/opendeck.metainfo.xml": "bundle/opendeck.metainfo.xml"
				}
			}
		},
		"publisher": "Sim Tuner",
		"shortDescription": "Golf-sim controller for the Ajazz AKP153E",
		"longDescription": "Sim Deck is a white-label build of OpenDeck for a Sim Tuner golf-sim controller on the Ajazz AKP153E. It is based on OpenDeck by nekename (GPL-3.0-or-later), modified by Sim Tuner.",
		"category": "Productivity",
		"icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"exceptionDomain": "localhost",
			"signingIdentity": "-"
		}
	},
	"productName": "Sim Deck",
	"mainBinaryName": "sim-deck",
	"identifier": "com.simtuner.deck",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["simtuner", "openaction"]
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "Sim Deck",
				"fullscreen": false,
				"resizable": true,
				"width": 800,
				"height": 600,
				"minWidth": 800,
				"minHeight": 600,
				"center": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://openactionapi.github.io https://api.github.com https://raw.githubusercontent.com https://plugins.amankhanna.me;"
		},
		"withGlobalTauri": true
	}
}
